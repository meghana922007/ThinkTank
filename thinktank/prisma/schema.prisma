// 1. THIS IS THE MISSING BLOCK
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 2. This tells Prisma how to generate the client
generator client {
  provider = "prisma-client-js"
}
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?   // For Credentials login
  image         String?
  points        Int       @default(0)
  lives         Int       @default(5)
  accounts      Account[]
  sessions      Session[]
  role          String?
}
// ... keep your datasource and generator at the top ...
// ... keep Account, Session, and User models ...

model Domain {
  id          String   @id
  name        String
  description String?
  puzzles     Puzzle[]
}

model Puzzle {
  id          String   @id @default(cuid())
  question    String   @db.Text
  answer      String
  hint        String?
  points      Int      @default(100)
  difficulty  String   @default("EASY")
  metadata    String?  @db.Text // Store options/grid as JSON string
  domainId    String
  domain      Domain   @relation(fields: [domainId], references: [id])
}